{
  "id": "./",
  "name": "DayDock — Workday Command Center",
  "short_name": "DayDock",
  "description": "A calm, local-first workday command center.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8f5ee",
  "theme_color": "#f8f5ee",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "./daydock-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./daydock-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./daydock-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./daydock-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshots/daydock-today.webp",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "DayDock Today workspace with the current Now outcome and Top 3 priorities"
    }
  ],
  "share_target": {
    "action": "./?share-target=1",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Capture to DayDock",
      "short_name": "Capture",
      "description": "Open Quick Capture",
      "url": "./?capture=1",
      "icons": [
        {
          "src": "./daydock-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
